;;; et-ai.el --- Generated from config.org -*- lexical-binding: t; -*-
(require 'seq)
(require 'subr-x)

(declare-function gptel-api-key-from-auth-source "gptel-request" (&optional host user))
(declare-function gptel-make-anthropic "gptel-anthropic" (name &rest args))
(declare-function gptel-make-deepseek "gptel-openai-extras" (name &rest args))
(declare-function gptel-make-openai "gptel-openai" (name &rest args))

(defvar et/ai-map (make-sparse-keymap "AI"))
(define-key et/leader-map (kbd "a") (cons "AI" et/ai-map))

(defvar et/gptel-keys nil
  "Cached auth-source API keys, keyed by host.")

(defvar et/gptel-openai nil)
(defvar et/gptel-anthropic nil)
(defvar et/gptel-deepseek nil)

(defun et/gptel-auth-source-key (host)
  "Prompt for machine/user and return HOST's key from auth-source."
  (require 'gptel)
  (let* ((machine (read-string (format "Auth machine for %s: " host) host))
         (user (read-string (format "Auth user for %s: " host) "apikey")))
    (gptel-api-key-from-auth-source machine user)))

(defun et/gptel-key (host)
  "Return HOST's cached key, prompting through auth-source when needed."
  (or (alist-get host et/gptel-keys nil nil #'equal)
      (let ((key (et/gptel-auth-source-key host)))
        (setf (alist-get host et/gptel-keys nil nil #'equal) key)
        key)))

(defun et/gptel-auth (&optional provider)
  "Prompt for and cache API keys for PROVIDER, or all providers."
  (interactive
   (list (completing-read "Provider: "
                          '("all" "api.openai.com" "api.anthropic.com" "api.deepseek.com")
                          nil t nil nil "all")))
  (let ((hosts (if (equal provider "all")
                   '("api.openai.com" "api.anthropic.com" "api.deepseek.com")
                 (list provider))))
    (dolist (host hosts)
      (setf (alist-get host et/gptel-keys nil nil #'equal)
            (et/gptel-auth-source-key host)))
    (message "Cached API key(s) for %s" (mapconcat #'identity hosts ", "))))

(defun et/gptel-toggle-reasoning ()
  "Toggle whether gptel includes reasoning text in responses."
  (interactive)
  (setq gptel-include-reasoning
        (if gptel-include-reasoning nil t))
  (message "gptel reasoning: %s"
           (if gptel-include-reasoning "included" "hidden")))

(defvar et/gptel-state-file
  (expand-file-name "gptel.el" et/state-directory)
  "Persistent gptel default backend and model.")

(defun et/gptel-select-model ()
  "Select a gptel model, returning (BACKEND . MODEL)."
  (require 'gptel)
  (let (models-alist)
    (dolist (entry gptel--known-backends)
      (let ((name (car entry))
            (backend (cdr entry)))
        (dolist (model (gptel-backend-models backend))
          (push (list (concat name ":" (gptel--model-name model))
                      backend model)
                models-alist))))
    (setq models-alist (nreverse models-alist))
    (let* ((completion-extra-properties
            `(:group-function
              ,(lambda (cand transform)
                 (if transform cand
                   (gptel-backend-name (nth 1 (assoc cand models-alist)))))
              :annotation-function
              ,(lambda (comp)
                 (let* ((model (nth 2 (assoc comp models-alist)))
                        (desc (get model :description)))
                   (when desc
                     (concat " "
                             (truncate-string-to-width desc 70 nil ?  t t)))))))
           (choice (completing-read
                    "Model: " models-alist nil t nil nil
                    (concat (gptel-backend-name gptel-backend) ":"
                            (gptel--model-name gptel-model))))
           (entry (assoc choice models-alist)))
      (when entry
        (cons (nth 1 entry) (nth 2 entry))))))

(defun et/gptel-save-default (backend model)
  "Persist BACKEND and MODEL as the default gptel choice."
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file et/gptel-state-file
      (insert ";; Generated by et/gptel-set-default; do not edit by hand.\n")
      (prin1 (list (cons 'backend (gptel-backend-name backend))
                   (cons 'model model))
             (current-buffer))
      (insert "\n")))
  (set-file-modes et/gptel-state-file #o600))

(defun et/gptel-load-default ()
  "Load the persisted gptel backend and model, when valid."
  (when (file-readable-p et/gptel-state-file)
    (condition-case nil
        (with-temp-buffer
          (insert-file-contents et/gptel-state-file)
          (goto-char (point-min))
          (let* ((state (read (current-buffer)))
                 (name (cdr (assq 'backend state)))
                 (model (cdr (assq 'model state)))
                 (backend (or (cdr (assoc name gptel--known-backends))
                              et/gptel-openai)))
            (when (and backend model
                       (memq model (gptel-backend-models backend)))
              (setq gptel-backend backend
                    gptel-model model))))
      (error nil))))

(defun et/gptel-set-default (&optional backend model)
  "Set BACKEND and MODEL as the persistent gptel default."
  (interactive
   (let ((choice (et/gptel-select-model)))
     (when choice
       (list (car choice) (cdr choice)))))
  (unless (and backend model)
    (user-error "No model selected"))
  (setq gptel-backend backend
        gptel-model model)
  (et/gptel-save-default backend model)
  (message "Default gptel model: %s / %s"
           (gptel-backend-name backend)
           (gptel--model-name model)))

(defun et/gptel-rewrite (&optional arg)
  "Rewrite the active region with a selected model.
With prefix ARG, set the selected model as the persistent default."
  (interactive "P")
  (require 'gptel-rewrite)
  (unless (use-region-p)
    (user-error "Select a region to rewrite"))
  (let* ((choice (et/gptel-select-model))
         (backend (car choice))
         (model (cdr choice))
         (scope (if arg
                    "Set as default"
                  (completing-read
                   "Use selected model: "
                   '("This rewrite only" "Set as default")
                   nil t nil nil "This rewrite only"))))
    (when (equal scope "Set as default")
      (et/gptel-set-default backend model))
    (let ((gptel-backend backend)
          (gptel-model model))
      (call-interactively #'gptel-rewrite))))

(defun et/gptel-configure ()
  "Create gptel backends that obtain keys through auth-source."
  (setq et/gptel-openai
        (gptel-make-openai "OpenAI"
          :host "api.openai.com"
          :key (lambda () (et/gptel-key "api.openai.com")))
        et/gptel-anthropic
        (gptel-make-anthropic "Anthropic"
          :host "api.anthropic.com"
          :key (lambda () (et/gptel-key "api.anthropic.com")))
        et/gptel-deepseek
        (gptel-make-deepseek "DeepSeek"
          :host "api.deepseek.com"
          :key (lambda () (et/gptel-key "api.deepseek.com")))
        gptel-backend et/gptel-openai
        gptel-model 'gpt-6-luna)
  (et/gptel-load-default))

(defun et/opencode-placeholder ()
