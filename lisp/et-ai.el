(defvar et/ai-map (make-sparse-keymap "AI"))
(define-key et/leader-map (kbd "a") (cons "AI" et/ai-map))

(defvar et/gptel-keys nil
  "Cached auth-source API keys, keyed by host.")

(defvar et/gptel-openai nil)
(defvar et/gptel-anthropic nil)
(defvar et/gptel-deepseek nil)

(defun et/gptel-auth-source-key (host)
  "Return HOST's auth-source key for user \"emacs\".
Prompt for a different machine and user only when no matching
auth-source entry exists."
  (require 'gptel)
  (let ((key nil))
    (condition-case nil
        (setq key (gptel-api-key-from-auth-source host "emacs"))
      (user-error nil))
    (unless (and key (not (string-empty-p key)))
      (let ((machine (read-string (format "Auth machine for %s: " host) host))
            (user (read-string (format "Auth user for %s: " host) "emacs")))
        (setq key (gptel-api-key-from-auth-source machine user))))
    key))

(defun et/gptel-key (host)
  "Return HOST's cached key, prompting through auth-source when needed."
  (or (alist-get host et/gptel-keys nil nil #'equal)
      (let ((key (et/gptel-auth-source-key host)))
        (setf (alist-get host et/gptel-keys nil nil #'equal) key)
        key)))

(defun et/gptel-auth (&optional provider)
  "Prompt for and cache API keys for PROVIDER, or all providers."
  (interactive
   (list (completing-read "Provider: "
                          '("all" "api.openai.com" "api.anthropic.com" "api.deepseek.com")
                          nil t nil nil "all")))
  (let ((hosts (if (equal provider "all")
                   '("api.openai.com" "api.anthropic.com" "api.deepseek.com")
                 (list provider))))
    (dolist (host hosts)
      (setf (alist-get host et/gptel-keys nil nil #'equal)
            (et/gptel-auth-source-key host)))
    (message "Cached API key(s) for %s" (mapconcat #'identity hosts ", "))))

(defun et/gptel-toggle-reasoning ()
  "Toggle whether gptel includes reasoning text in responses."
  (interactive)
  (setq gptel-include-reasoning
        (if gptel-include-reasoning nil t))
  (message "gptel reasoning: %s"
           (if gptel-include-reasoning "included" "hidden")))

;;; Model favorites

(defvar et/model-favorites-file
  (expand-file-name "model-favorites.el" et/state-directory)
  "Persistent favorite models for OpenCode and gptel.")

(defvar et/model-favorites nil
  "Alist of (KIND . MODELS); KIND is `opencode' or `gptel'.")

(defun et/model-favorites-load ()
  "Load persisted model favorites."
  (setq et/model-favorites
        (when (file-readable-p et/model-favorites-file)
          (condition-case nil
              (with-temp-buffer
                (insert-file-contents et/model-favorites-file)
                (goto-char (point-min))
                (read (current-buffer)))
            (error nil))))
  et/model-favorites)

(defun et/model-favorites-save ()
  "Persist model favorites with private file permissions."
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file et/model-favorites-file
      (insert ";; Generated by et/model-toggle-favorite; do not edit by hand.\n")
      (prin1 et/model-favorites (current-buffer))
      (insert "\n")))
  (set-file-modes et/model-favorites-file #o600))

(defun et/model-favorite-list (kind)
  "Return the favorite model strings for KIND."
  (cdr (assq kind et/model-favorites)))

(defun et/model-favorite-p (kind model)
  "Return non-nil when MODEL is a favorite of KIND."
  (member model (et/model-favorite-list kind)))

(defun et/model-toggle-favorite (kind model)
  "Toggle MODEL as a favorite of KIND.
Return non-nil when MODEL was added."
  (let* ((current (et/model-favorite-list kind))
         (favorite (member model current))
         (updated (if favorite
                      (cl-remove model current :test #'equal)
                    (cons model (copy-sequence current)))))
    (setf (alist-get kind et/model-favorites nil nil #'eq) updated)
    (et/model-favorites-save)
    (not favorite)))

(defun et/model--ordered (kind choices group-function)
  "Return (ORDERED . GROUP-FUNCTION) with KIND favorites first.
CHOICES is the original candidate list.  GROUP-FUNCTION labels the
non-favorite candidates."
  (let* ((favorites (seq-filter (lambda (choice)
                                  (et/model-favorite-p kind choice))
                                choices))
         (others (seq-remove (lambda (choice)
                               (et/model-favorite-p kind choice))
                             choices)))
    (cons (append favorites others)
          (lambda (candidate transform)
            (cond
             ((et/model-favorite-p kind candidate)
              (if transform candidate "★ Favorites"))
             (group-function
              (funcall group-function candidate transform))
             (t (if transform candidate "")))))))

(defun et/model--current-candidate ()
  "Return the candidate at point in the active completion minibuffer."
  (let ((candidate
         (if (and (fboundp 'vertico--candidate)
                  (boundp 'vertico--index)
                  (integerp vertico--index)
                  (>= vertico--index 0))
             (vertico--candidate)
           (minibuffer-contents-no-properties))))
    (and (stringp candidate) (substring-no-properties candidate))))

(defun et/model--toggle-current (kind choices favoritable-p)
  "Toggle the current completion candidate as a KIND favorite.
FAVORITABLE-P limits which CHOICES can be favorited."
  (let ((candidate (et/model--current-candidate)))
    (cond
     ((not (and candidate (member candidate choices)))
      (message "Point is not on a model"))
     ((and favoritable-p (not (funcall favoritable-p candidate)))
      (message "This entry cannot be favorited"))
     (t
      (let ((added (et/model-toggle-favorite kind candidate)))
        (message "%s %s" (if added "Favorited" "Unfavorited") candidate)
        (throw 'et/model--favorite-toggled (cons :retry candidate)))))))

(defun et/model--favorite-setup (kind choices favoritable-p)
  "Return a minibuffer setup hook for KIND favorites.
CHOICES is the candidate list.  FAVORITABLE-P limits toggle targets.
The hook binds the favorite-toggle key only for this minibuffer."
  (lambda ()
    (let* ((base (or (current-local-map) minibuffer-local-completion-map))
           (map (copy-keymap base)))
      (define-key map (kbd "C-f")
                  (lambda ()
                    (interactive)
                    (et/model--toggle-current kind choices favoritable-p)))
      (use-local-map map))))

(defun et/model--read (prompt choices kind &optional default
                              group-function annotation-function
                              favoritable-p)
  "Read a model from CHOICES with KIND favorites first.
PROMPT is the completion prompt.  GROUP-FUNCTION and ANNOTATION-FUNCTION
are passed to completion.  FAVORITABLE-P limits favorite-toggle targets.
Return the selected model string, or nil when cancelled."
  (let (selection retry)
    (while (progn
             (setq retry nil)
             (let* ((ordered-info (et/model--ordered kind choices group-function))
                    (ordered (car ordered-info))
                    (group-fn (cdr ordered-info))
                    (completion-extra-properties
                     `(:display-sort-function identity
                       :cycle-sort-function identity
                       :group-function ,group-fn
                       ,@(when annotation-function
                           `(:annotation-function ,annotation-function)))))
               (let ((result
                      (catch 'et/model--favorite-toggled
                        (setq selection
                              (let ((minibuffer-setup-hook
                                     (append minibuffer-setup-hook
                                             (list
                                              (et/model--favorite-setup
                                               kind choices favoritable-p)))))
                                (completing-read
                                 prompt ordered nil t nil nil
                                 (or default (car ordered))))))))
                 (when (and (consp result) (eq (car result) :retry))
                   (setq default (cdr result)
                         retry t))))
             retry))
    selection))

;;; Per-project AI models

(defvar et/project-models-file
  (expand-file-name "project-models.el" et/state-directory)
  "Persistent per-project OpenCode and gptel model choices.")

(defvar et/project-models nil
  "Alist of (ROOT . PLIST); PLIST has :opencode and :gptel entries.")

(defun et/project--canonical-root (root)
  "Return ROOT as a canonical directory name, or nil."
  (when (and root (stringp root))
    (file-name-as-directory
     (expand-file-name (if (file-exists-p root) (file-truename root) root)))))

(defun et/project-models-load ()
  "Load persisted per-project model choices."
  (setq et/project-models
        (when (file-readable-p et/project-models-file)
          (condition-case nil
              (with-temp-buffer
                (insert-file-contents et/project-models-file)
                (goto-char (point-min))
                (read (current-buffer)))
            (error nil))))
  et/project-models)

(defun et/project-models-save ()
  "Persist per-project model choices with private permissions."
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file et/project-models-file
      (insert ";; Generated by et/project-configure-models; do not edit by hand.\n")
      (prin1 et/project-models (current-buffer))
      (insert "\n")))
  (set-file-modes et/project-models-file #o600))

(defun et/project-model-get (root key)
  "Return ROOT's project model entry KEY."
  (let* ((root (et/project--canonical-root root))
         (plist (alist-get root et/project-models nil nil #'equal)))
    (plist-get plist key)))

(defun et/project-model-set (root key value)
  "Set ROOT's project model entry KEY to VALUE."
  (let* ((root (et/project--canonical-root root))
         (plist (copy-sequence
                 (alist-get root et/project-models nil nil #'equal))))
    (setf (alist-get root et/project-models nil nil #'equal)
          (plist-put plist key value))))

(defun et/project-models-configured-p (root)
  "Return non-nil when ROOT has both project models."
  (and (et/project-model-get root :opencode)
       (et/project-model-get root :gptel)))

(defun et/opencode--cli-models (root)
  "Return OpenCode's model names for ROOT using the CLI."
  (when (and root (executable-find "opencode"))
    (let ((default-directory
           (file-name-as-directory (expand-file-name root))))
      (condition-case nil
          (delete-dups
           (seq-filter
            (lambda (line)
              (string-match-p "\\`[^[:space:]/]+/[^[:space:]]+\\'" line))
            (process-lines "opencode" "models")))
        (error nil)))))

(defun et/opencode--display-provider (display)
  "Return DISPLAY's provider name for completion grouping."
  (if (string-match "/" display)
      (substring display 0 (match-beginning 0))
    "Models"))

(defun et/project--opencode-config-model (root)
  "Return ROOT's existing opencode.json model, when readable."
  (let ((file (expand-file-name "opencode.json"
                               (et/project--canonical-root root))))
    (when (file-readable-p file)
      (condition-case nil
          (with-temp-buffer
            (insert-file-contents file)
            (goto-char (point-min))
            (alist-get 'model (json-parse-buffer :object-type 'alist)))
        (error nil)))))

(defun et/opencode--read-project-model (root)
  "Read ROOT's OpenCode model from the CLI catalog."
  (let* ((models (et/opencode--cli-models root))
         (configured (or (et/project-model-get root :opencode)
                         (et/project--opencode-config-model root)))
         (default (if (member configured models) configured (car models))))
    (unless models
      (user-error "OpenCode models are not available"))
    (et/model--read
     (format "OpenCode model for %s: "
             (file-name-nondirectory
              (directory-file-name (et/project--canonical-root root))))
     models 'opencode default
     (lambda (candidate transform)
       (if transform
           candidate
         (et/opencode--display-provider candidate))))))

(defun et/project--write-opencode-model (root model)
  "Write MODEL to ROOT's opencode.json, preserving other settings."
  (condition-case err
      (let* ((root (et/project--canonical-root root))
             (file (expand-file-name "opencode.json" root))
             (config
              (cond
               ((not (file-exists-p file)) nil)
               (t (condition-case nil
                      (with-temp-buffer
                        (insert-file-contents file)
                        (goto-char (point-min))
                        (json-parse-buffer :object-type 'alist))
                    (error :invalid))))))
        (if (eq config :invalid)
            (progn
              (message "Leaving unreadable OpenCode config unchanged: %s" file)
              nil)
          (let ((config (copy-sequence config)))
            (setf (alist-get 'model config) model)
            (unless (assoc '$schema config)
              (push '($schema . "https://opencode.ai/config.json") config))
            (let ((temp (make-temp-file
                         (expand-file-name ".opencode-" root) nil ".json")))
              (unwind-protect
                  (progn
                    (with-temp-file temp
                      (insert (json-serialize config))
                      (json-pretty-print (point-min) (point-max))
                      (insert "\n"))
                    (rename-file temp file t)
                    (set-file-modes file #o644))
                (when (file-exists-p temp)
                  (delete-file temp))))
            t)))
    (error
     (message "Could not update OpenCode config: %s"
              (error-message-string err))
     nil)))

(defun et/gptel-backend-by-name (name)
  "Return the gptel backend named NAME."
  (or (cdr (assoc name gptel--known-backends))
      (seq-find (lambda (backend)
                  (and backend
                       (equal (gptel-backend-name backend) name)))
                (list et/gptel-openai et/gptel-anthropic et/gptel-deepseek))
      et/gptel-openai))

(defun et/project-gptel-choice (root)
  "Return ROOT's stored gptel choice as (BACKEND . MODEL), when valid."
  (when-let* ((root (et/project--canonical-root root))
              (stored (et/project-model-get root :gptel))
              (name (car-safe stored))
              (model (cdr-safe stored)))
    (let ((backend (et/gptel-backend-by-name name)))
      (when (and backend model
                 (memq model (gptel-backend-models backend)))
        (cons backend model)))))

(defun et/project-apply-gptel-model (&optional root)
  "Apply ROOT's project gptel model in the current buffer."
  (when (locate-library "gptel")
    (require 'gptel)
    (let* ((root (or (et/project--canonical-root root)
                     (ignore-errors
                       (et/project--canonical-root
                        (projectile-project-root)))))
           (choice (and root (et/project-gptel-choice root))))
      (when choice
        (setq-local gptel-backend (car choice)
                    gptel-model (cdr choice))))))

(defun et/gptel-default-display ()
  "Return the default gptel model display for the current project."
  (let* ((root (ignore-errors
                 (et/project--canonical-root (projectile-project-root))))
         (choice (and root (et/project-gptel-choice root)))
         (backend (or (car-safe choice) gptel-backend))
         (model (or (cdr-safe choice) gptel-model)))
    (when (and backend model)
      (concat (gptel-backend-name backend) ":"
              (gptel--model-name model)))))

(defun et/project-configure-opencode-model (root)
  "Prompt for and persist ROOT's OpenCode model."
  (let* ((root (et/project--canonical-root root))
         (choice (et/opencode--read-project-model root)))
    (when choice
      (et/project-model-set root :opencode choice)
      (et/project-models-save)
      (et/project--write-opencode-model root choice)
      (message "OpenCode project model: %s" choice)
      choice)))

(defun et/project-configure-gptel-model (root)
  "Prompt for and persist ROOT's gptel model."
  (unless (locate-library "gptel")
    (user-error "Install gptel with et/install-packages"))
  (require 'gptel)
  (let* ((root (et/project--canonical-root root))
         (default-directory root)
         (choice (et/gptel-select-model)))
    (when choice
      (et/project-model-set
       root :gptel
       (cons (gptel-backend-name (car choice)) (cdr choice)))
      (et/project-models-save)
      (et/project-apply-gptel-model root)
      (message "gptel project model: %s / %s"
               (gptel-backend-name (car choice))
               (gptel--model-name (cdr choice)))
      choice)))

(defun et/project-ensure-models (&optional root)
  "Ensure ROOT has OpenCode and gptel models, prompting once."
  (let ((root (et/project--canonical-root
               (or root
                   (ignore-errors (projectile-project-root))))))
    (when (and root
               (not (file-remote-p root))
               (not (et/project-models-configured-p root)))
      (unless (et/project-model-get root :opencode)
        (if (executable-find "opencode")
            (condition-case err
                (et/project-configure-opencode-model root)
              (quit nil)
              (user-error
               (message "%s" (error-message-string err))))
          (message "OpenCode CLI not found; skipping project OpenCode model")))
      (unless (et/project-model-get root :gptel)
        (if (locate-library "gptel")
            (condition-case err
                (et/project-configure-gptel-model root)
              (quit nil)
              (user-error
               (message "%s" (error-message-string err))))
          (message "gptel not installed; skipping project gptel model")))
      (et/project-apply-gptel-model root))
    root))

(defun et/project-configure-models (&optional root)
  "Prompt for both project models for ROOT, replacing saved choices."
  (interactive)
  (let ((root (et/project--canonical-root
               (or root
                   (ignore-errors (projectile-project-root))))))
    (unless root
      (user-error "Not in a project"))
    (condition-case err
        (et/project-configure-opencode-model root)
      (quit nil)
      (user-error
       (message "%s" (error-message-string err))))
    (condition-case err
        (et/project-configure-gptel-model root)
      (quit nil)
      (user-error
       (message "%s" (error-message-string err))))
    (message "Project models updated for %s"
             (file-name-nondirectory (directory-file-name root)))))

(defun et/opencode-select-project-model (&optional root)
  "Select and persist ROOT's OpenCode model."
  (interactive)
  (let* ((root (et/project--canonical-root
                (or root
                    (ignore-errors (projectile-project-root)))))
         (choice (and root (et/project-configure-opencode-model root))))
    (unless root
      (user-error "Not in a project"))
    (when (and choice
               (derived-mode-p 'opencode-session-mode)
               (string-match "/" choice))
      (opencode-session--apply-model-selection
       (substring choice 0 (match-beginning 0))
       (substring choice (match-end 0))))))

;;; Saved OpenCode sessions

(defvar et/opencode-sessions-directory
  (expand-file-name "opencode-sessions/" et/state-directory)
  "Directory holding exported OpenCode session context.")

(defvar et/opencode-sessions-file
  (expand-file-name "opencode-sessions.el" et/state-directory)
  "Persistent OpenCode session bookmarks.")

(defvar et/opencode-sessions nil
  "Alist of (ROOT . SESSIONS) for saved OpenCode sessions.")

(defun et/opencode-sessions-load ()
  "Load persisted OpenCode session bookmarks."
  (setq et/opencode-sessions
        (when (file-readable-p et/opencode-sessions-file)
          (condition-case nil
              (with-temp-buffer
                (insert-file-contents et/opencode-sessions-file)
                (goto-char (point-min))
                (read (current-buffer)))
            (error nil))))
  et/opencode-sessions)

(defun et/opencode-sessions-save ()
  "Persist OpenCode session bookmarks with private permissions."
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file et/opencode-sessions-file
      (insert ";; Generated by et/opencode-session-save; do not edit by hand.\n")
      (prin1 et/opencode-sessions (current-buffer))
      (insert "\n")))
  (set-file-modes et/opencode-sessions-file #o600))

(defun et/opencode-session--records (root)
  "Return saved OpenCode session records for ROOT."
  (alist-get (et/project--canonical-root root)
             et/opencode-sessions nil nil #'equal))

(defun et/opencode-session--upsert (root record)
  "Store RECORD as ROOT's newest saved OpenCode session."
  (let* ((root (et/project--canonical-root root))
         (id (plist-get record :id))
         (records (et/opencode-session--records root)))
    (setf (alist-get root et/opencode-sessions nil nil #'equal)
          (cons record
                (cl-remove id records
                           :key (lambda (item) (plist-get item :id))
                           :test #'equal)))))

(defun et/opencode-session--buffer-session ()
  "Return the current buffer's OpenCode session, when present."
  (when (derived-mode-p 'opencode-session-mode)
    (bound-and-true-p opencode-session--session)))

(defun et/opencode-session--root (&optional prompt)
  "Return the project root for session commands.
When PROMPT is non-nil, offer saved project roots or read a directory."
  (or (ignore-errors
        (et/project--canonical-root (projectile-project-root)))
      (when-let* ((session (et/opencode-session--buffer-session))
                  (directory (opencode-session-directory session)))
        (et/project--canonical-root directory))
      (when prompt
        (let ((roots (mapcar #'car et/opencode-sessions)))
          (et/project--canonical-root
           (if roots
               (completing-read "Project: " roots nil t)
             (read-directory-name "Project directory: "
                                  default-directory nil t)))))))

(defun et/opencode-session--record (session root)
  "Return a bookmark record for SESSION in ROOT."
  (let* ((info (or (opencode-session-info session) '()))
         (model-info (alist-get 'model info))
         (id (opencode-session-id session))
         (title (or (opencode-session-title session) "Untitled session"))
         (provider (or (bound-and-true-p opencode-session--provider-id)
                       (alist-get 'providerID model-info)))
         (model (or (bound-and-true-p opencode-session--model-id)
                    (alist-get 'id model-info)))
         (agent (or (bound-and-true-p opencode-session--agent)
                    (alist-get 'agent info)))
         (directory (or (opencode-session-directory session) root)))
    (list :id id
          :title title
          :saved (format-time-string "%Y-%m-%d %H:%M:%S")
          :directory directory
          :provider provider
          :model model
          :agent agent
          :export (expand-file-name
                   (concat (replace-regexp-in-string
                            "[^[:alnum:]_.-]" "_" (or id "session"))
                           ".json")
                   et/opencode-sessions-directory))))

(defun et/opencode-session--export (record)
  "Export RECORD's session context to its JSON file."
  (condition-case err
      (let ((id (plist-get record :id))
            (directory (plist-get record :directory))
            (file (plist-get record :export)))
        (when (and (executable-find "opencode")
                   (stringp id)
                   (stringp directory)
                   (not (file-remote-p directory)))
          (make-directory (file-name-directory file) t)
          (let ((default-directory (file-name-as-directory directory))
                (coding-system-for-write 'utf-8-unix))
            (with-temp-buffer
              (let ((status (call-process
                             "opencode" nil t nil
                             "session" "export" id)))
                (when (and (integerp status) (zerop status)
                           (> (buffer-size) 0))
                  (write-region (point-min) (point-max) file nil 'silent)
                  (set-file-modes file #o600)
                  t))))))
    (error
     (message "OpenCode context export failed: %s"
              (error-message-string err))
     nil)))

(defun et/opencode-session--choices (records)
  "Return completion choices for saved session RECORDS."
  (mapcar
   (lambda (record)
     (cons (format "%s  [%s]  %s"
                   (plist-get record :title)
                   (plist-get record :id)
                   (plist-get record :saved))
           record))
   records))

(defun et/opencode-session--read-record (prompt root)
  "Read a saved session for ROOT using PROMPT."
  (let* ((records (et/opencode-session--records root))
         (choices (et/opencode-session--choices records)))
    (unless records
      (user-error "No saved OpenCode sessions for this project"))
    (let ((choice (completing-read prompt choices nil t nil nil
                                   (caar choices))))
      (cdr (assoc choice choices)))))

(defun et/opencode-session-save ()
  "Save the current OpenCode session bookmark and export its context."
  (interactive)
  (let ((session (et/opencode-session--buffer-session)))
    (unless session
      (user-error "Open an OpenCode session buffer first"))
    (let* ((root (or (et/opencode-session--root)
                     (et/project--canonical-root default-directory)))
           (record (et/opencode-session--record session root)))
      (unless (plist-get record :id)
        (user-error "OpenCode session has no ID"))
      (et/opencode-session--upsert root record)
      (et/opencode-sessions-save)
      (message "Exporting OpenCode session context...")
      (if (et/opencode-session--export record)
          (message "Saved OpenCode session and context: %s"
                   (plist-get record :title))
        (message "Saved OpenCode session bookmark: %s"
                 (plist-get record :title)))
      record)))

(defun et/opencode-session-select (&optional root)
  "Select a saved OpenCode session in ROOT and reopen it."
  (interactive)
  (let* ((root (or root (et/opencode-session--root t)))
         (record (et/opencode-session--read-record
                  "OpenCode session: " root)))
    (require 'emacs-opencode)
    (opencode-open-session-by-id (plist-get record :id) root)
    (message "Opening OpenCode session: %s"
             (plist-get record :title))))

(defun et/opencode-session-delete (&optional root)
  "Delete a saved OpenCode session bookmark for ROOT."
  (interactive)
  (let* ((root (or root (et/opencode-session--root t)))
         (record (et/opencode-session--read-record
                  "Delete OpenCode session bookmark: " root))
         (id (plist-get record :id)))
    (when (yes-or-no-p
           (format "Delete saved session %s? "
                   (plist-get record :title)))
      (setf (alist-get root et/opencode-sessions nil nil #'equal)
            (cl-remove id (et/opencode-session--records root)
                       :key (lambda (item) (plist-get item :id))
                       :test #'equal))
      (et/opencode-sessions-save)
      (message "Deleted saved OpenCode session: %s (context file kept)"
               (plist-get record :title)))))

(defvar et/gptel-state-file
  (expand-file-name "gptel.el" et/state-directory)
  "Persistent gptel default backend and model.")

(defun et/gptel-select-model ()
  "Select a gptel model, returning (BACKEND . MODEL)."
  (require 'gptel)
  (let (models-alist choices)
    (dolist (entry gptel--known-backends)
      (let ((name (car entry))
            (backend (cdr entry)))
        (dolist (model (gptel-backend-models backend))
          (push (list (concat name ":" (gptel--model-name model))
                      backend model)
                models-alist))))
    (setq models-alist (nreverse models-alist)
          choices (mapcar #'car models-alist))
    (let* ((group-function
            (lambda (cand transform)
              (if transform
                  cand
                (gptel-backend-name (nth 1 (assoc cand models-alist))))))
           (annotation-function
            (lambda (comp)
              (let* ((model (nth 2 (assoc comp models-alist)))
                     (desc (get model :description)))
                (when desc
                  (concat " "
                          (truncate-string-to-width desc 70 nil ?  t t))))))
           (choice (et/model--read
                    "Model: " choices 'gptel
                    (et/gptel-default-display)
                    group-function annotation-function))
           (entry (assoc choice models-alist)))
      (when entry
        (cons (nth 1 entry) (nth 2 entry))))))

(defun et/gptel-save-default (backend model)
  "Persist BACKEND and MODEL as the default gptel choice."
  (let ((coding-system-for-write 'utf-8-unix))
    (with-temp-file et/gptel-state-file
      (insert ";; Generated by et/gptel-set-default; do not edit by hand.\n")
      (prin1 (list (cons 'backend (gptel-backend-name backend))
                   (cons 'model model))
             (current-buffer))
      (insert "\n")))
  (set-file-modes et/gptel-state-file #o600))

(defun et/gptel-load-default ()
  "Load the persisted gptel backend and model, when valid."
  (when (file-readable-p et/gptel-state-file)
    (condition-case nil
        (with-temp-buffer
          (insert-file-contents et/gptel-state-file)
          (goto-char (point-min))
          (let* ((state (read (current-buffer)))
                 (name (cdr (assq 'backend state)))
                 (model (cdr (assq 'model state)))
                 (backend (or (cdr (assoc name gptel--known-backends))
                              et/gptel-openai)))
            (when (and backend model
                       (memq model (gptel-backend-models backend)))
              (setq gptel-backend backend
                    gptel-model model))))
      (error nil))))

(defun et/gptel-set-default (&optional backend model)
  "Set BACKEND and MODEL as the persistent gptel default."
  (interactive
   (let ((choice (et/gptel-select-model)))
     (when choice
       (list (car choice) (cdr choice)))))
  (unless (and backend model)
    (user-error "No model selected"))
  (setq gptel-backend backend
        gptel-model model)
  (et/gptel-save-default backend model)
  (message "Default gptel model: %s / %s"
           (gptel-backend-name backend)
           (gptel--model-name model)))

(defun et/gptel-rewrite (&optional arg)
  "Rewrite the active region with a selected model.
With prefix ARG, set the selected model as the persistent default."
  (interactive "P")
  (require 'gptel-rewrite)
  (unless (use-region-p)
    (user-error "Select a region to rewrite"))
  (et/project-ensure-models)
  (let* ((choice (et/gptel-select-model))
         (backend (car choice))
         (model (cdr choice))
         (scope (if arg
                    "Set as default"
                  (completing-read
                   "Use selected model: "
                   '("This rewrite only" "Set as default")
                   nil t nil nil "This rewrite only"))))
    (when (equal scope "Set as default")
      (et/gptel-set-default backend model))
    (let ((gptel-backend backend)
          (gptel-model model))
      (call-interactively #'gptel-rewrite))))

(defun et/gptel ()
  "Start a gptel chat with the current project's model when configured."
  (interactive)
  (et/project-ensure-models)
  (et/project-apply-gptel-model)
  (let* ((root (ignore-errors (projectile-project-root)))
         (buffer (call-interactively #'gptel)))
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (et/project-apply-gptel-model root)))))

(defun et/gptel-send ()
  "Send with the current project's model when configured."
  (interactive)
  (et/project-ensure-models)
  (et/project-apply-gptel-model)
  (call-interactively #'gptel-send))

(defun et/gptel-configure ()
  "Create gptel backends that obtain keys through auth-source."
  (setq et/gptel-openai
        (gptel-make-openai "OpenAI"
          :host "api.openai.com"
          :key (lambda () (et/gptel-key "api.openai.com")))
        et/gptel-anthropic
        (gptel-make-anthropic "Anthropic"
          :host "api.anthropic.com"
          :key (lambda () (et/gptel-key "api.anthropic.com")))
        et/gptel-deepseek
        (gptel-make-deepseek "DeepSeek"
          :host "api.deepseek.com"
          :key (lambda () (et/gptel-key "api.deepseek.com")))
        gptel-backend et/gptel-openai
        gptel-model 'gpt-6-luna)
  (et/gptel-load-default))

