#!/bin/sh
# Block pushing the practice-only branch onto main.
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref:$remote_ref" in
    refs/heads/dape-practice:refs/heads/main)
      echo "Refusing to push dape-practice to main; it is a practice-only branch." >&2
      status=1
      ;;
  esac
done
exit "$status"
