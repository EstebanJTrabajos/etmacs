;;; et-profile-tests.el --- Profile isolation checks -*- lexical-binding: t; -*-
;; Loaded by et-core-tests.el after isolated configuration startup.

(ert-deftest et/profile-catalog-has-personal-work-and-general ()
  (dolist (name '("personal" "work" "general"))
    (should (et/profile-valid-p name)))
  (should (equal (plist-get (et/profile-spec "personal") :opencode-model)
                 "deepseek/deepseek-flash"))
  (should (equal (plist-get (et/profile-spec "work") :opencode-model)
                 "openai/gpt-6-sol"))
  (should (equal (plist-get (et/profile-spec "general") :opencode-model)
                 "openai/gpt-6-luna")))

(ert-deftest et/profile-applies-domain-state-and-models ()
  (let* ((et/state-directory (make-temp-file "etmacs-profile-" t))
         (et/profile "general")
         (et/profile-domains '("general"))
         (et/profile-state-directory et/state-directory)
         (et/profile-opencode-model nil)
         (et/profile-opencode-binary "opencode")
         (et/profile-hidden-providers nil)
         (et/org-domain "general")
         (et/org-agenda-scope "general")
         (et/dashboard-agenda-domains '("general")))
    (et/profile-apply "work")
    (should (equal et/profile "work"))
    (should (equal et/org-domain "work"))
    (should (equal et/org-agenda-scope "work"))
    (should (equal et/profile-domains '("work" "general")))
    (should (equal et/dashboard-agenda-domains '("work" "general")))
    (should (equal et/profile-opencode-model "openai/gpt-6-sol"))
    (should (equal et/profile-opencode-binary "opencode2"))
    (should (file-in-directory-p et/profile-state-directory
                                 et/state-directory))
    (should (file-directory-p et/profile-state-directory))
    (should (et/profile-model-hidden-p "deepseek/deepseek-flash"))
    (should (et/profile-model-hidden-p "DeepSeek:deepseek-chat"))
    (should-not (et/profile-model-hidden-p "openai/gpt-6-sol"))))

(ert-deftest et/profile-selection-persists-with-private-permissions ()
  (let* ((et/state-directory (make-temp-file "etmacs-profile-" t))
         (et/profile-file (expand-file-name "profile" et/state-directory))
         (et/profile "general")
         (et/profile-domains '("general"))
         (et/profile-state-directory et/state-directory)
         (et/profile-opencode-model nil)
         (et/profile-opencode-binary "opencode")
         (et/profile-hidden-providers nil)
         (et/org-domain "general")
         (et/org-agenda-scope "general")
         (et/dashboard-agenda-domains '("general")))
    (et/profile-save "personal")
    (should (= (logand (file-modes et/profile-file) #o777) #o600))
    (should (equal (et/profile--read-selection) "personal"))
    (et/profile-apply "general")
    (et/profile-load nil)
    (should (equal et/profile "personal"))
    (should (equal et/org-domain "personal"))
    (should (equal et/profile-opencode-binary "opencode"))))

(ert-deftest et/profile-batch-fallback-is-general ()
  (let* ((et/state-directory (make-temp-file "etmacs-profile-" t))
         (et/profile-file (expand-file-name "profile" et/state-directory))
         (et/profile "work")
         (et/profile-domains '("work" "general"))
         (et/profile-state-directory et/state-directory)
         (et/profile-opencode-model nil)
         (et/profile-opencode-binary "opencode")
         (et/profile-hidden-providers nil)
         (et/org-domain "work")
         (et/org-agenda-scope "work")
         (et/dashboard-agenda-domains '("work" "general")))
    (et/profile-load nil)
    (should (equal et/profile "general"))
    (should (equal et/profile-domains '("general")))
    ;; Batch use must not consume the first interactive prompt.
    (should-not (file-exists-p et/profile-file))))

(ert-deftest et/profile-prompts-only-when-nothing-is-saved ()
  (let* ((et/state-directory (make-temp-file "etmacs-profile-" t))
         (et/profile-file (expand-file-name "profile" et/state-directory))
         (et/profile "general")
         (et/profile-domains '("general"))
         (et/profile-state-directory et/state-directory)
         (et/profile-opencode-model nil)
         (et/profile-opencode-binary "opencode")
         (et/profile-hidden-providers nil)
         (et/org-domain "general")
         (et/org-agenda-scope "general")
         (et/dashboard-agenda-domains '("general"))
         (noninteractive nil)
         (prompts 0))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (&rest _)
                 (setq prompts (1+ prompts))
                 "work")))
      (et/profile-load t)
      (should (= prompts 1))
      (should (equal et/profile "work"))
      (et/profile-load t)
      (should (= prompts 1)))))

(ert-deftest et/profile-capture-templates-follow-visible-domains ()
  (let ((et/profile-domains '("work" "general")))
    (should-not (et/capture-template-visible-p '("pt" "TODO")))
    (should-not (et/capture-template-visible-p '("p" "Personal")))
    (should (et/capture-template-visible-p '("wt" "TODO")))
    (should (et/capture-template-visible-p '("gt" "TODO")))
    (should (et/capture-template-visible-p '("gI" "Idea")))
    (should (et/capture-template-visible-p '("j" "Project task")))))

(ert-deftest et/profile-tags-and-menu-are-profile-aware ()
  (should (equal (et/profile-tag "personal") "personal"))
  (should (equal (et/profile-tag "work") "work"))
  (should (equal (et/profile-tag "general") "general"))
  (should (eq (lookup-key et/leader-map (kbd "C s")) 'et/switch-profile))
  (should (eq (lookup-key et/leader-map (kbd "C n"))
              'et/change-news-summary-model))
  (should (eq (lookup-key et/leader-map (kbd "C P")) 'et/profile-show))
  (should (eq (lookup-key et/news-map (kbd "C"))
              'et/change-news-summary-model)))

(ert-deftest et/profile-state-files-are-profile-local ()
  (should (file-in-directory-p et/profile-state-directory et/test-state))
  (should (file-in-directory-p et/project-models-file
                               et/profile-state-directory))
  (should (file-in-directory-p et/opencode-sessions-file
                               et/profile-state-directory))
  (should (file-in-directory-p et/model-favorites-file
                               et/profile-state-directory))
  (should (file-in-directory-p et/gptel-state-file
                               et/profile-state-directory))
  (should (file-in-directory-p org-roam-db-location
                               et/profile-state-directory))
  (should (file-in-directory-p projectile-known-projects-file
                               et/profile-state-directory)))

(ert-deftest et/profile-news-summary-model-remains-gpt-6-luna ()
  (should (eq et/news-summary-model 'gpt-6-luna))
  (should (commandp 'et/change-news-summary-model)))

(ert-deftest et/profile-news-summary-model-can-change-for-the-session ()
  (let ((et/news-summary-model 'gpt-6-luna)
        (et/news-summary-backend nil))
    (cl-letf (((symbol-function 'et/news--select-model)
               (lambda () (cons 'fake-backend 'fake-model)))
              ((symbol-function 'gptel-backend-name)
               (lambda (_backend) "Fake"))
              ((symbol-function 'gptel--model-name)
               (lambda (model) (format "%s" model))))
      (et/change-news-summary-model)
      (should (eq et/news-summary-model 'fake-model))
      (should (eq et/news-summary-backend 'fake-backend)))))
