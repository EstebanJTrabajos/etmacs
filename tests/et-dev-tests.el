(ert-deftest et/dev-format-dispatches-to-standalone-formatter ()
  (let (captured)
    (cl-letf (((symbol-function 'et/dev-format-file)
               (lambda (file argv) (setq captured (list file argv))))
              ((symbol-function 'et/dev-node-environment) (lambda () nil)))
      (with-temp-buffer
        (python-mode)
        (setq buffer-file-name "/tmp/f.py")
        (et/dev-format)
        (should (equal captured '("/tmp/f.py" ("ruff" "format")))))
      (with-temp-buffer
        (js-mode)
        (setq buffer-file-name "/tmp/f.ts")
        (et/dev-format)
        (should (equal captured '("/tmp/f.ts" ("prettier" "--write")))))
      (with-temp-buffer
        (c-mode)
        (setq buffer-file-name "/tmp/f.c")
        (et/dev-format)
        (should (equal captured '("/tmp/f.c" ("clang-format" "-i")))))
      (with-temp-buffer
        (c++-mode)
        (setq buffer-file-name "/tmp/f.cpp")
        (et/dev-format)
        (should (equal captured '("/tmp/f.cpp" ("clang-format" "-i")))))
      (with-temp-buffer
        (fundamental-mode)
        (setq buffer-file-name "/tmp/f.txt")
        (should-error (et/dev-format) :type 'user-error)))))

