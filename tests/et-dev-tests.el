;;; et-dev-tests.el --- Development checks without external services -*- lexical-binding: t; -*-
(ert-deftest et/dev-files-use-intended-modes-and-leaders ()
  (skip-unless (locate-library "yaml-mode"))
  (dolist (spec '(("fixture.py" python-mode python-ts-mode)
                  ("fixture.js" js-mode js-ts-mode)
                  ("fixture.ts" typescript-mode typescript-ts-mode)
                  ("fixture.tsx" web-mode tsx-ts-mode)
                  ("fixture.yaml" yaml-mode yaml-ts-mode)
                  ("fixture.yml" yaml-mode yaml-ts-mode)
                  ("Fixture.java" java-mode java-ts-mode)
                  ("fixture.sql" sql-mode)
                  ("fixture.yar" yara-mode) ("fixture.yara" yara-mode)
                  ("Dockerfile" dockerfile-mode dockerfile-ts-mode)
                  ("Dockerfile.dev" dockerfile-mode dockerfile-ts-mode)
                  ("fixture.dockerfile" dockerfile-mode dockerfile-ts-mode)
                  ("compose.yml" et/compose-mode)
                  ("compose.yaml" et/compose-mode)
                  ("compose.override.yaml" et/compose-mode)
                  ("docker-compose.yml" et/compose-mode)
                  ("docker-compose.dev.yml" et/compose-mode)))
    (with-temp-buffer
      (setq buffer-file-name (expand-file-name (car spec) et/test-state))
      (cl-letf (((symbol-function 'eglot-ensure) (lambda () (ert-fail "Automatic Eglot")))
                ((symbol-function 'eglot) (lambda (&rest _) (ert-fail "Automatic Eglot"))))
        (set-auto-mode))
      (should (memq major-mode (cdr spec)))
      (should (eq et/local-leader-map et/dev-map))
      (when (derived-mode-p 'web-mode) (should-not electric-pair-mode))
      (should-not (eglot-managed-p))
      (should-not (memq 'eglot-format-buffer before-save-hook)))))

(ert-deftest et/dev-eglot-server-mappings ()
  (should (equal (cdr (assoc '(et/compose-mode :language-id "yaml") eglot-server-programs))
                 '("yaml-language-server" "--stdio")))
  (should (equal (cdr (assq 'sql-mode eglot-server-programs)) '("sqls")))
  (should (seq-some (lambda (entry)
                      (string-match-p "typescript-language-server" (prin1-to-string entry)))
                    eglot-server-programs))
  (should (equal (cdr (assq 'yara-mode eglot-server-programs)) '("yr-ls"))))

(ert-deftest et/dev-tree-sitter-is-optional ()
  (cl-letf (((symbol-function 'treesit-ready-p) (lambda (language quiet)
                                                (should quiet)
                                                (eq language 'python))))
    (should (et/tree-sitter-ready-p 'python))
    (should-not (et/tree-sitter-ready-p 'not-installed))))

(ert-deftest et/dev-python-environment-is-buffer-local ()
  (let* ((root (expand-file-name "venv-fixture/" et/test-state))
         (bin (expand-file-name "bin/" root))
         (python (expand-file-name "python" bin))
         (original-path (getenv "PATH"))
         (original-exec exec-path))
    (make-directory bin t)
    (with-temp-file python (insert "#!/bin/sh\nexit 0\n"))
    (set-file-modes python #o700)
    (with-temp-buffer
      (python-mode)
      (et/python-environment root)
      (should (equal python-shell-interpreter python))
      (should (equal (getenv "VIRTUAL_ENV") (directory-file-name root)))
      (should (equal (car exec-path) bin))
      (et/python-environment root)
      (should (= (seq-count (lambda (path) (equal path bin)) exec-path) 1)))
    (should (equal (getenv "PATH") original-path))
    (should (eq exec-path original-exec))
    (with-temp-buffer
      (should-error (et/python-environment root) :type 'user-error))))

(ert-deftest et/dev-node-tools-are-opt-in-and-local ()
  (let* ((root (expand-file-name "node-fixture/" et/test-state))
         (bin (expand-file-name "node_modules/.bin/" root))
         (original (getenv "PATH")))
    (make-directory bin t)
    (with-temp-buffer
      (js-mode)
      (cl-letf (((symbol-function 'et/dev-project-root) (lambda () root)))
        (et/dev-node-environment))
      (should (equal (car exec-path) bin))
      (should (string-prefix-p bin (getenv "PATH"))))
    (should (equal original (getenv "PATH")))
    (with-temp-buffer
      (js-mode)
      (setq default-directory "/ssh:unreachable:/project/")
      (cl-letf (((symbol-function 'et/dev-project-root)
                 (lambda () (ert-fail "Remote project path was probed"))))
        (et/dev-node-environment)))))

(ert-deftest et/dev-lsp-commands-are-explicit ()
  (with-temp-buffer
    (python-mode)
    (should-error (et/lsp-format) :type 'user-error)
    (should-error (et/lsp-stop) :type 'user-error)
    (let (started)
      (cl-letf (((symbol-function 'eglot) (lambda () (interactive) (setq started t))))
        (et/lsp-start)
        (should started))))
  (dolist (key '("l" "q" "f" "r" "a" "d" "R" "h" "e" "E" "n" "p" "c" "t" "v" "V"))
    (should (commandp (lookup-key et/dev-map (kbd key))))))

(ert-deftest et/dev-compose-validation-is-nondeploying-and-quoted ()
  (skip-unless (locate-library "yaml-mode"))
  (require 'yaml-mode)
  (with-temp-buffer
    (et/compose-mode)
    (setq buffer-file-name (expand-file-name "a directory/compose.yml" et/test-state))
    (set-buffer-modified-p nil)
    (let (command)
      (cl-letf (((symbol-function 'executable-find) (lambda (_) "/usr/bin/docker"))
                ((symbol-function 'compilation-start) (lambda (cmd &rest _) (setq command cmd))))
        (et/compose-validate)
        (should (equal command
                       (mapconcat #'shell-quote-argument
                                  (list "docker" "compose" "-f" buffer-file-name "config" "--quiet") " ")))))
    (setq buffer-file-name "/ssh:unreachable:/compose.yml")
    (should-error (et/compose-validate) :type 'user-error)))

(ert-deftest et/dev-compose-validation-does-not-silently-save ()
  (skip-unless (locate-library "yaml-mode"))
  (require 'yaml-mode)
  (with-temp-buffer
    (et/compose-mode)
    (setq buffer-file-name (expand-file-name "compose.yml" et/test-state))
    (insert "services: {}\n")
    (cl-letf (((symbol-function 'executable-find) (lambda (_) "/usr/bin/docker"))
              ((symbol-function 'yes-or-no-p) (lambda (&rest _) nil))
              ((symbol-function 'save-buffer) (lambda (&rest _) (ert-fail "Silent save")))
              ((symbol-function 'compilation-start) (lambda (&rest _) (ert-fail "Ignored cancellation"))))
      (should-error (et/compose-validate) :type 'user-error))))

(ert-deftest et/dev-docker-ui-loads-without-contacting-daemon ()
  (skip-unless (locate-library "docker"))
  (require 'docker)
  (should (commandp (lookup-key et/project-map (kbd "D")))))

(ert-deftest et/dev-eglot-capf-flymake-xref-and-format-integration ()
  ;; Exercise a real Eglot JSON-RPC connection without installing a production
  ;; server or contacting external services. Language-specific checks are manual.
  (skip-unless (executable-find "python3"))
  (let* ((root (expand-file-name "lsp-fixture/" et/test-state))
         (file (expand-file-name "fixture.py" root))
         (eglot-sync-connect 5)
         (eglot-autoshutdown t)
         (eglot-confirm-server-initiated-edits nil)
         buffer server)
    (make-directory root t)
    (with-temp-file (expand-file-name ".projectile" root))
    (with-temp-file file (insert "ans\n"))
    (unwind-protect
        (progn
          (setq buffer (find-file-noselect file))
          (with-current-buffer buffer
            (eglot '(python-mode) (project-current nil root) 'eglot-lsp-server
                   (list (executable-find "python3")
                         (expand-file-name "tests/fixtures/lsp-server.py" et/test-root))
                   '("python"))
            (setq server (eglot-current-server))
            (should (eglot-managed-p))
            (should flymake-mode)
            (should (memq #'eglot-completion-at-point completion-at-point-functions))
            (goto-char (point-min))
            (forward-char 3)
            (let* ((capf (eglot-completion-at-point))
                   (completions (all-completions "ans" (nth 2 capf))))
              (should (member "answer" completions)))
            (flymake-start)
            (let ((deadline (+ (float-time) 5)))
              (while (and (not (flymake-diagnostics)) (< (float-time) deadline))
                (accept-process-output nil 0.1)))
            (should (seq-some (lambda (diag)
                                (string-match-p "Fixture diagnostic" (flymake-diagnostic-text diag)))
                              (flymake-diagnostics)))
            (should (xref-backend-definitions (xref-find-backend) "ans"))
            (et/lsp-format)
            (should (equal (buffer-string) "answer = 42\n"))))
      (when server (ignore-errors (eglot-shutdown server)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer)))))
