(ert-deftest et/dev-treesit-installer-skips-ready-grammars ()
  (let (installed)
    (cl-letf (((symbol-function 'treesit-available-p) (lambda () t))
              ((symbol-function 'et/tree-sitter-ready-p)
               (lambda (grammar) (eq grammar 'python)))
              ((symbol-function 'treesit-install-language-grammar)
               (lambda (grammar directory)
                 (push (cons grammar directory) installed)))
              ((symbol-function 'et/treesit-refresh-remaps) (lambda () nil)))
      (et/treesit-install-grammars))
    (should-not (assq 'python installed))
    (should (assq 'javascript installed))
    (should (assq 'typescript installed))))
