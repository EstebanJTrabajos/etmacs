(ert-deftest et/dev-js-runner-detection ()
  (let ((root (expand-file-name "js-runner-fixture/" et/test-state))
        (pkg (expand-file-name "js-runner-fixture/package.json" et/test-state)))
    (make-directory root t)
    (with-temp-file pkg (insert "{\"devDependencies\":{\"vitest\":\"^2.0.0\"}}"))
    (should (eq (et/dev-js-runner root) :vitest))
    (with-temp-file pkg (insert "{\"devDependencies\":{\"jest\":\"^29.0.0\"}}"))
    (should (eq (et/dev-js-runner root) :jest))
    (with-temp-file pkg (insert "{\"scripts\":{\"test\":\"vitest run\"}}"))
    (should (eq (et/dev-js-runner root) :vitest))
    (with-temp-file pkg (insert "{\"scripts\":{\"test\":\"jest --coverage\"}}"))
    (should (eq (et/dev-js-runner root) :jest))
    (with-temp-file pkg (insert "{\"scripts\":{\"build\":\"tsc\"}}"))
    (should-not (et/dev-js-runner root))
    (delete-file pkg)
    (should-not (et/dev-js-runner root))))

