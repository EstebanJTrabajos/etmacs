(ert-deftest et/dev-debug-repl-ret-sends-input ()
  (skip-unless (require 'dape nil t))
  (dolist (key '("RET" "<return>" "C-m"))
    (should (eq (lookup-key dape-repl-mode-map (kbd key))
                #'comint-send-input)))
  (dolist (key '("S-<return>" "M-<return>"))
    (should (eq (lookup-key dape-repl-mode-map (kbd key))
                #'comint-accumulate)))
  (when (featurep 'evil)
    (with-temp-buffer
      (evil-local-mode 1)
      (dape-repl-mode)
      (unwind-protect
          (progn
            ;; The mode hook starts the REPL in insert state.
            (should (eq evil-state 'insert))
            (dolist (state '(normal insert motion emacs))
              (funcall (intern (format "evil-%s-state" state)))
              (should (eq (key-binding (kbd "RET")) #'comint-send-input))
              (should (eq (key-binding (kbd "<return>"))
                          #'comint-send-input)))
            (should (equal comint-input-ring-file-name
                           (expand-file-name "dape-repl-history"
                                             et/state-directory))))
        (evil-normal-state)
        (set-buffer-modified-p nil)))))

