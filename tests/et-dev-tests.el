(ert-deftest et/dev-python-environment-is-buffer-local ()
  (let* ((root (expand-file-name "venv-fixture/" et/test-state))
         (bin (expand-file-name "bin/" root))
         (python (expand-file-name "python" bin))
         (et/python-environment-selected (make-hash-table :test #'equal))
         (original-path (getenv "PATH"))
         (original-exec exec-path))
    (make-directory bin t)
    (with-temp-file python (insert "#!/bin/sh\nexit 0\n"))
    (set-file-modes python #o700)
    (with-temp-buffer
      (python-mode)
      (et/python-environment root)
      (should (equal python-shell-interpreter python))
      (should (equal python-shell-interpreter-args "-i"))
      (should (equal python-shell-virtualenv-root (directory-file-name root)))
      (should (equal (getenv "VIRTUAL_ENV") (directory-file-name root)))
      (should (equal (car exec-path) bin))
      (et/python-environment root)
      (should (= (seq-count (lambda (path) (equal path bin)) exec-path) 1)))
    (should (equal (getenv "PATH") original-path))
    (should (eq exec-path original-exec))
    (with-temp-buffer
      (should-error (et/python-environment root) :type 'user-error))))

