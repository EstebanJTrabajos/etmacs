(ert-deftest et/dev-debug-action-conditions-gate-actions ()
  (skip-unless (require 'dape nil t))
  (let ((result "true")
        (blocking nil))
    (cl-letf (((symbol-function 'dape--current-stack-frame)
               (lambda (_conn) '(:id 7)))
              ((symbol-function 'dape--evaluate-expression)
               (lambda (_conn frame expression _context cb)
                 (should (= frame 7))
                 (should (equal expression "value > 1"))
                 (setq blocking dape--request-blocking)
                 (funcall cb (list :result result) nil))))
      (should (et/dape-action-condition-met-p
               'fake '(:type elisp :value "x" :condition "value > 1")))
      (should blocking)
      (setq result "false")
      (should-not (et/dape-action-condition-met-p
                   'fake '(:type elisp :value "x" :condition "value > 1")))
      (setq result "null")
      (should-not (et/dape-action-condition-met-p
                   'fake '(:type elisp :value "x" :condition "value > 1"))))
    ;; No condition means no evaluation at all.
    (let (called)
      (cl-letf (((symbol-function 'dape--evaluate-expression)
                 (lambda (&rest _) (setq called t))))
        (should (et/dape-action-condition-met-p
                 'fake '(:type elisp :value "x")))
        (should-not called)))))

