(ert-deftest et/dev-eglot-capf-flymake-xref-and-format-integration ()
  ;; Exercise a real Eglot JSON-RPC connection without installing a production
  ;; server or contacting external services. Language-specific checks are manual.
  (skip-unless (executable-find "python3"))
  (let* ((root (expand-file-name "lsp-fixture/" et/test-state))
         (file (expand-file-name "fixture.py" root))
         (eglot-sync-connect 5)
         (eglot-autoshutdown t)
         (eglot-confirm-server-initiated-edits nil)
         buffer server)
    (make-directory root t)
    (with-temp-file (expand-file-name ".projectile" root))
    (with-temp-file file (insert "ans\n"))
    (unwind-protect
        (progn
          (setq buffer (find-file-noselect file))
          (with-current-buffer buffer
            (eglot '(python-mode) (project-current nil root) 'eglot-lsp-server
                   (list (executable-find "python3")
                         (expand-file-name "tests/fixtures/lsp-server.py" et/test-root))
                   '("python"))
            (setq server (eglot-current-server))
            (should (eglot-managed-p))
            (should flymake-mode)
            (should (memq #'eglot-completion-at-point completion-at-point-functions))
            (goto-char (point-min))
            (forward-char 3)
            (let* ((capf (eglot-completion-at-point))
                   (completions (all-completions "ans" (nth 2 capf))))
              (should (member "answer" completions)))
            (flymake-start)
            (let ((deadline (+ (float-time) 5)))
              (while (and (not (flymake-diagnostics)) (< (float-time) deadline))
                (accept-process-output nil 0.1)))
            (should (seq-some (lambda (diag)
                                (string-match-p "Fixture diagnostic" (flymake-diagnostic-text diag)))
                              (flymake-diagnostics)))
            (should (xref-backend-definitions (xref-find-backend) "ans"))
            (et/lsp-format)
            (should (equal (buffer-string) "answer = 42\n"))))
      (when server (ignore-errors (eglot-shutdown server)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer)))))

