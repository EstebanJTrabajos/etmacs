(ert-deftest et/dev-files-use-intended-modes-and-leaders ()
  (skip-unless (locate-library "yaml-mode"))
  (dolist (spec '(("fixture.py" python-mode python-ts-mode)
                  ("fixture.js" js-mode js-ts-mode)
                  ("fixture.ts" typescript-mode typescript-ts-mode)
                  ("fixture.tsx" web-mode tsx-ts-mode)
                  ("fixture.c" c-mode c-ts-mode)
                  ("fixture.h" c-mode c-ts-mode)
                  ("fixture.cpp" c++-mode c++-ts-mode)
                  ("fixture.hpp" c++-mode c++-ts-mode)
                  ("fixture.yaml" yaml-mode yaml-ts-mode)
                  ("fixture.yml" yaml-mode yaml-ts-mode)
                  ("Fixture.java" java-mode java-ts-mode)
                  ("fixture.sql" sql-mode)
                  ("fixture.yar" yara-mode) ("fixture.yara" yara-mode)
                  ("Dockerfile" dockerfile-mode dockerfile-ts-mode)
                  ("Dockerfile.dev" dockerfile-mode dockerfile-ts-mode)
                  ("fixture.dockerfile" dockerfile-mode dockerfile-ts-mode)
                  ("compose.yml" et/compose-mode)
                  ("compose.yaml" et/compose-mode)
                  ("compose.override.yaml" et/compose-mode)
                  ("docker-compose.yml" et/compose-mode)
                  ("docker-compose.dev.yml" et/compose-mode)))
    (with-temp-buffer
      (setq buffer-file-name (expand-file-name (car spec) et/test-state))
      (cl-letf (((symbol-function 'eglot-ensure) (lambda () (ert-fail "Automatic Eglot")))
                ((symbol-function 'eglot) (lambda (&rest _) (ert-fail "Automatic Eglot"))))
        (set-auto-mode))
      (should (memq major-mode (cdr spec)))
      (should (eq et/local-leader-map et/dev-map))
      (when (derived-mode-p 'web-mode) (should-not electric-pair-mode))
      (should-not (eglot-managed-p))
      (should-not (memq 'eglot-format-buffer before-save-hook)))))

(ert-deftest et/dev-eglot-server-mappings ()
