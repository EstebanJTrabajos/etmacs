(ert-deftest et/dev-format-file-formats-and-reloads ()
  (let* ((file (expand-file-name "format-target.py" et/test-state))
         (formatter (expand-file-name "formatter.sh" et/test-state))
         buffer)
    (with-temp-file file (insert "old\n"))
    (with-temp-file formatter (insert "#!/bin/sh\nprintf 'formatted\\n' > \"$1\"\n"))
    (set-file-modes formatter #o700)
    (setq buffer (find-file-noselect file))
    (unwind-protect
        (with-current-buffer buffer
          (should (equal (buffer-string) "old\n"))
          (et/dev-format-file file (list formatter))
          (should (equal (buffer-string) "formatted\n")))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer)))))

