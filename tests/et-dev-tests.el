(ert-deftest et/dev-compose-validation-is-nondeploying-and-quoted ()
  (skip-unless (locate-library "yaml-mode"))
  (require 'yaml-mode)
  (with-temp-buffer
    (et/compose-mode)
    (setq buffer-file-name (expand-file-name "a directory/compose.yml" et/test-state))
    (set-buffer-modified-p nil)
    (let (command)
      (cl-letf (((symbol-function 'executable-find) (lambda (_) "/usr/bin/docker"))
                ((symbol-function 'compilation-start) (lambda (cmd &rest _) (setq command cmd))))
        (et/compose-validate)
        (should (equal command
                       (mapconcat #'shell-quote-argument
                                  (list "docker" "compose" "-f" buffer-file-name "config" "--quiet") " ")))))
    (setq buffer-file-name "/ssh:unreachable:/compose.yml")
    (should-error (et/compose-validate) :type 'user-error)))

