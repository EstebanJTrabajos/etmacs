(ert-deftest et/dev-lsp-start-propagates-buffer-environment ()
  (let* ((root (expand-file-name "env-prop-fixture/" et/test-state))
         (bin (expand-file-name "bin/" root))
         (python (expand-file-name "python" bin))
         (et/python-environment-selected (make-hash-table :test #'equal)))
    (make-directory bin t)
    (with-temp-file python (insert "#!/bin/sh\nexit 0\n"))
    (set-file-modes python #o700)
    (with-temp-buffer
      (python-mode)
      (et/python-environment root)
      (let (seen-env)
        (cl-letf (((symbol-function 'eglot)
                   (lambda () (interactive) (setq seen-env process-environment))))
          (et/lsp-start))
        (cl-labels ((env-var (name env)
                              (seq-some (lambda (entry)
                                          (and (string-prefix-p (concat name "=") entry)
                                               (substring entry (1+ (length name)))))
                                        env)))
          (should (equal (env-var "VIRTUAL_ENV" seen-env) (directory-file-name root)))
          (should (string-prefix-p bin (or (env-var "PATH" seen-env) ""))))))))

