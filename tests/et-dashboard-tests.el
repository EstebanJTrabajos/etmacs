(ert-deftest et/dashboard-task-other-actions-use-source-context ()
  (et/with-test-vault
    (let* ((file (et/test-agenda-file (expand-file-name "personal/tasks.org" et/notes-directory)
                                     "Editable task"))
           (projectile-known-projects nil)
           (recentf-list nil)
           (elfeed-db t)
           (elfeed-db-entries (make-hash-table :test #'equal))
           seen)
      (save-window-excursion
        (et/dashboard)
        (goto-char (point-min))
        (search-forward "Editable task")
        (cl-letf (((symbol-function 'call-interactively)
                   (lambda (command &rest _)
                     (should (equal buffer-file-name file))
                     (should (equal (org-get-heading t t t t) "Editable task"))
                     (push command seen))))
          (et/dashboard-task-priority)
          (et/dashboard-task-tags)
          (et/dashboard-task-effort))
        (should (equal (nreverse seen) '(org-priority org-set-tags-command org-set-effort)))
        (let ((marker (et/dashboard-task-at-point)))
          (et/dashboard-refresh)
          (should-not (marker-buffer marker)))))))

(ert-deftest et/dashboard-task-state-note-is-saved-after-finalizing ()
  (et/with-test-vault
    (let* ((file (et/test-agenda-file (expand-file-name "personal/tasks.org" et/notes-directory)
                                     "Task to cancel"))
           (projectile-known-projects nil)
           (recentf-list nil)
           (elfeed-db t)
           (elfeed-db-entries (make-hash-table :test #'equal)))
      (save-window-excursion
        (et/dashboard)
        (goto-char (point-min))
        (search-forward "Task to cancel")
        (cl-letf (((symbol-function 'org-fast-todo-selection)
                   (lambda (&rest _) "CANCELLED")))
          (et/dashboard-task-todo))
        (should (get-buffer "*Org Note*"))
        (with-current-buffer "*Org Note*"
          (goto-char (point-max))
          (insert "No longer needed")
          (funcall org-finish-function))
        (should (string-match-p "CANCELLED Task to cancel" (et/test-file-text file)))
        (should (string-match-p "No longer needed" (et/test-file-text file)))
        (should-not (buffer-modified-p (get-file-buffer file)))
        (with-current-buffer et/dashboard-buffer-name
          (should-not (string-match-p "Task to cancel" (buffer-string))))))))

(ert-deftest et/dashboard-renders-required-sections ()
  (et/with-test-vault
    (let ((projectile-known-projects nil)
          (recentf-list nil)
          (org-agenda-files nil)
          (elfeed-db t)
          (elfeed-db-entries (make-hash-table :test #'equal))
          (et/org-domain "personal"))
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (should (derived-mode-p 'et/dashboard-mode))
        (let ((text (buffer-string)))
          (dolist (section '("Projects" "Recent files" "Agenda"
                             "Daily journal" "News"))
            (should (string-match-p section text)))
          (should (string-match-p "Scientific American" text))
          (should (string-match-p "New York Times" text))
          (should (string-match-p "No cached articles" text))
          (should (string-match-p "Open full feed" text))
          (should (string-match-p "No open tasks" text)))
        (should (eq (lookup-key et/dashboard-mode-map (kbd "g"))
                    'et/dashboard-refresh)))
      (should (eq (lookup-key et/leader-map (kbd "d")) 'et/dashboard)))))

