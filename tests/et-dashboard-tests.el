;;; et-dashboard-tests.el --- Dashboard checks -*- lexical-binding: t; -*-
;; Loaded by et-core-tests.el after isolated configuration startup.
(require 'button)

(ert-deftest et/dashboard-leader-works-with-evil ()
  (skip-unless (featurep 'evil))
  (with-temp-buffer
    (et/dashboard-mode)
    (evil-local-mode 1)
    (evil-normal-state)
    (should (eq (evil-initial-state major-mode) 'normal))
    (should (eq et/local-leader-map et/dashboard-leader-map))
    (dolist (state '(normal visual motion))
      (evil-change-state state)
      (dolist (binding '(("t" . et/dashboard-task-todo)
                         ("s" . et/dashboard-task-schedule)
                         ("D" . et/dashboard-task-deadline)
                         ("P" . et/dashboard-task-priority)
                         ("T" . et/dashboard-task-tags)
                         ("E" . et/dashboard-task-effort)
                         ("e" . et/dashboard-task-edit)
                         ("g" . et/dashboard-refresh)
                         ("d" . et/dashboard-daily)
                         ("S" . et/news-summarize-at-point)))
        (should (eq (key-binding (kbd (concat "SPC m " (car binding)))) (cdr binding)))))
    (evil-normal-state)
    (should (eq (key-binding (kbd "j")) #'evil-next-line))
    ;; Evil deliberately ignores destructive operators in read-only modes.
    (should-not (eq (key-binding (kbd "d")) #'et/dashboard-daily))
    (should-not (eq (key-binding (kbd "s")) #'et/dashboard-task-schedule))))

(ert-deftest et/dashboard-task-edits-save-source-and-refresh ()
  (et/with-test-vault
    (let* ((file (et/test-agenda-file (expand-file-name "personal/tasks.org" et/notes-directory)
                                     "Editable task"))
           (projectile-known-projects nil)
           (recentf-list nil)
           (elfeed-db t)
           (elfeed-db-entries (make-hash-table :test #'equal))
           (org-log-done 'time))
      (save-window-excursion
        (et/dashboard)
        (goto-char (point-min))
        (search-forward "Editable task")
        (should (eq (lookup-key et/dashboard-mode-map (kbd "s")) #'et/dashboard-task-schedule))
        ;; A live marker must follow edits made before this heading.
        (with-current-buffer (find-file-noselect file)
          (goto-char (point-min))
          (insert "#+title: Added after rendering\n\n"))
        (cl-letf (((symbol-function 'org-read-date)
                   (lambda (_with-time to-time &rest _)
                     (setq org-time-was-given t)
                     (if to-time
                         (encode-time 0 30 14 25 11 2026)
                       "2026-11-25 14:30"))))
          (et/dashboard-task-schedule)
          (et/dashboard-task-deadline))
        (should (string-match-p "SCHEDULED: <2026-11-25 Wed 14:30>"
                                (et/test-file-text file)))
        (should (string-match-p "DEADLINE: <2026-11-25 Wed 14:30>"
                                (et/test-file-text file)))
        (should (markerp (et/dashboard-task-at-point)))
        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Remove deadline")))
          (et/dashboard-task-edit))
        (should-not (string-match-p "DEADLINE:" (et/test-file-text file)))
        (let ((current-prefix-arg '(4)))
          (et/dashboard-task-schedule))
        (should-not (string-match-p "SCHEDULED:" (et/test-file-text file)))
        (cl-letf (((symbol-function 'org-fast-todo-selection) (lambda (&rest _) "DONE")))
          (et/dashboard-task-todo))
        (should (string-match-p "\\* DONE Editable task" (et/test-file-text file)))
        (should-not (string-match-p "Editable task" (buffer-string)))
        (should-not (buffer-modified-p (get-file-buffer file)))))))

