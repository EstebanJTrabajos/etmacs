;;; et-dashboard-tests.el --- Dashboard checks -*- lexical-binding: t; -*-
;; Loaded by et-core-tests.el after isolated configuration startup.
(require 'button)

(ert-deftest et/dashboard-renders-required-sections ()
  (et/with-test-vault
    (let ((projectile-known-projects nil)
          (recentf-list nil)
          (org-agenda-files nil)
          (elfeed-db t)
          (elfeed-db-entries (make-hash-table :test #'equal))
          (et/org-domain "personal"))
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (should (derived-mode-p 'et/dashboard-mode))
        (let ((text (buffer-string)))
          (dolist (section '("Projects" "Recent files" "Agenda"
                             "Daily journal" "News"))
            (should (string-match-p section text)))
          (should (string-match-p "Scientific American" text))
          (should (string-match-p "New York Times" text))
          (should (string-match-p "No cached articles" text))
          (should (string-match-p "Open full feed" text))
          (should (string-match-p "Nothing scheduled for today" text)))
        (should (eq (lookup-key et/dashboard-mode-map (kbd "g"))
                    'et/dashboard-refresh)))
      (should (eq (lookup-key et/leader-map (kbd "d")) 'et/dashboard)))))

(ert-deftest et/dashboard-renders-project-and-recent-buttons ()
  (et/with-test-vault
    (let* ((project (expand-file-name "project/" directory))
           (file (expand-file-name "recent.org" directory))
           (projectile-known-projects (list project))
           (recentf-list (list file))
           (org-agenda-files nil)
           (et/org-domain "personal"))
      (make-directory project t)
      (with-temp-file file (insert "Recent fixture\n"))
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (should (string-match-p (regexp-quote (abbreviate-file-name project))
                                (buffer-string)))
        (should (string-match-p (regexp-quote (abbreviate-file-name file))
                                (buffer-string)))
        (goto-char (point-min))
        (should (next-button (point-min)))))))

(ert-deftest et/dashboard-project-entry-activates-workspace ()
  (let (seen)
    (cl-letf (((symbol-function 'projectile-switch-project-by-name)
               (lambda (project) (setq seen project))))
      (et/dashboard-open-project "/tmp/dashboard-project/")
      (should (equal seen "/tmp/dashboard-project/")))))

(ert-deftest et/dashboard-agenda-shows-today-todo ()
  (et/with-test-vault
    (let* ((file (expand-file-name "personal/tasks.org" et/notes-directory))
           (org-agenda-files (list file))
           (et/org-domain "personal"))
      (make-directory (file-name-directory file) t)
      (with-temp-file file (insert "* TODO Today task\n"))
      (should (seq-some (lambda (item)
                          (string-match-p "Today task" (nth 0 item)))
                        (et/dashboard-agenda-items))))))

(ert-deftest et/dashboard-is-the-startup-buffer-choice ()
  (should (eq initial-buffer-choice #'et/dashboard-buffer))
  (et/with-test-vault
    (let ((projectile-known-projects nil)
          (recentf-list nil)
          (org-agenda-files nil)
          (et/org-domain "personal"))
      (let ((buffer (et/dashboard-buffer)))
        (should (buffer-live-p buffer))
        (with-current-buffer buffer
          (should (derived-mode-p 'et/dashboard-mode)))))))

(ert-deftest et/dashboard-ret-follows-links ()
  (should (eq (lookup-key et/dashboard-mode-map (kbd "RET"))
              'et/follow-link-at-point))
  (should (eq (lookup-key et/dashboard-mode-map (kbd "<return>"))
              'et/follow-link-at-point)))

(ert-deftest et/dashboard-project-button-runs-its-action ()
  (et/with-test-vault
    (let* ((project (expand-file-name "project/" directory))
           (projectile-known-projects (list project))
           (recentf-list nil)
           (org-agenda-files nil)
           (et/org-domain "personal")
           seen)
      (make-directory project t)
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (let ((button (next-button (point-min))))
          (should button)
          (cl-letf (((symbol-function 'projectile-switch-project-by-name)
                     (lambda (root) (setq seen root))))
            (push-button button)))
        (should (equal seen project))))))

(ert-deftest et/dashboard-daily-and-agenda-buttons-accept-button-argument ()
  (et/with-test-vault
    (let ((projectile-known-projects nil)
          (recentf-list nil)
          (org-agenda-files nil)
          (elfeed-db t)
          (elfeed-db-entries (make-hash-table :test #'equal))
          (et/org-domain "personal")
          daily agenda)
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (goto-char (point-min))
        (search-forward "Open today's journal")
        (let ((button (next-button (line-beginning-position))))
          (should button)
          (cl-letf (((symbol-function 'et/daily)
                     (lambda (&rest _) (setq daily t))))
            (funcall (button-get button 'action) button))
          (should daily))
        (goto-char (point-min))
        (search-forward "Open agenda")
        (let ((button (next-button (line-beginning-position))))
          (should button)
          (cl-letf (((symbol-function 'et/dashboard-agenda)
                     (lambda (&rest _) (setq agenda t))))
            (funcall (button-get button 'action) button))
          (should agenda))))))

(ert-deftest et/dashboard-news-collapses-and-expands-with-tab ()
  (et/with-test-vault
    (let ((projectile-known-projects nil)
          (recentf-list nil)
          (org-agenda-files nil)
          (elfeed-db t)
          (elfeed-db-entries (make-hash-table :test #'equal))
          (et/org-domain "personal")
          (et/dashboard-news-expanded t))
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (should (string-match-p "Hide articles" (buffer-string)))
        (et/dashboard-toggle-news)
        (should (string-match-p "Show articles" (buffer-string)))
        (should-not (string-match-p "No cached articles" (buffer-string)))
        (et/dashboard-toggle-news)
        (should (string-match-p "Hide articles" (buffer-string))))
      (should (eq (lookup-key et/dashboard-mode-map (kbd "TAB"))
                  'et/dashboard-toggle-news)))))
