(ert-deftest et/dashboard-project-button-runs-its-action ()
  (et/with-test-vault
    (let* ((project (expand-file-name "project/" directory))
           (projectile-known-projects (list project))
           (recentf-list nil)
           (org-agenda-files nil)
           (et/org-domain "personal")
           seen)
      (make-directory project t)
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (let ((button (next-button (point-min))))
          (should button)
          (cl-letf (((symbol-function 'projectile-switch-project-by-name)
                     (lambda (root) (setq seen root))))
            (push-button button)))
        (should (equal seen project))))))

(ert-deftest et/dashboard-daily-and-agenda-buttons-accept-button-argument ()
  (et/with-test-vault
    (let ((projectile-known-projects nil)
          (recentf-list nil)
          (org-agenda-files nil)
          (elfeed-db t)
          (elfeed-db-entries (make-hash-table :test #'equal))
          (et/org-domain "personal")
          daily agenda)
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (goto-char (point-min))
        (search-forward "Open today's journal")
        (let ((button (next-button (line-beginning-position))))
          (should button)
          (cl-letf (((symbol-function 'et/daily)
                     (lambda (&rest _) (setq daily t))))
            (funcall (button-get button 'action) button))
          (should daily))
        (goto-char (point-min))
        (search-forward "Open agenda")
        (let ((button (next-button (line-beginning-position))))
          (should button)
          (cl-letf (((symbol-function 'et/dashboard-agenda)
                     (lambda (&rest _) (setq agenda t))))
            (funcall (button-get button 'action) button))
          (should agenda))))))

(ert-deftest et/dashboard-news-tab-collapses-one-feed ()
  (et/with-test-vault
    (let ((projectile-known-projects nil)
          (recentf-list nil)
          (org-agenda-files nil)
          (elfeed-db t)
          (elfeed-db-entries (make-hash-table :test #'equal))
          (et/org-domain "personal")
          (et/dashboard-news-collapsed nil))
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (should (eq (lookup-key et/dashboard-mode-map (kbd "TAB"))
                    'et/dashboard-toggle-news-feed))
        (should (= 7 (count-matches "No cached articles"
                                    (point-min) (point-max))))
        (goto-char (point-min))
        (search-forward "Scientific American")
        (should (eq (et/dashboard-news-site-at-point) 'sciam))
        (et/dashboard-toggle-news-feed)
        (should (member 'sciam et/dashboard-news-collapsed))
        (should (= 6 (count-matches "No cached articles"
                                    (point-min) (point-max))))
        (should (string-match-p "New York Times" (buffer-string)))
        (goto-char (point-min))
        (search-forward "Scientific American")
        (et/dashboard-toggle-news-feed)
        (should-not (member 'sciam et/dashboard-news-collapsed))
        (should (= 7 (count-matches "No cached articles"
                                    (point-min) (point-max))))))))
