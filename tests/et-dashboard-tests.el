;;; et-dashboard-tests.el --- Dashboard checks -*- lexical-binding: t; -*-
;; Loaded by et-core-tests.el after isolated configuration startup.
(require 'button)

(ert-deftest et/dashboard-renders-required-sections ()
  (et/with-test-vault
    (let ((projectile-known-projects nil)
          (recentf-list nil)
          (org-agenda-files nil)
          (elfeed-db t)
          (elfeed-db-entries (make-hash-table :test #'equal))
          (et/org-domain "personal"))
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (should (derived-mode-p 'et/dashboard-mode))
        (let ((text (buffer-string)))
          (dolist (section '("Projects" "Recent files" "Agenda"
                             "Daily journal" "News"))
            (should (string-match-p section text)))
          (should (string-match-p "Scientific American" text))
          (should (string-match-p "New York Times" text))
          (should (string-match-p "No cached articles" text))
          (should (string-match-p "Open full feed" text))
          (should (string-match-p "No open tasks" text)))
        (should (eq (lookup-key et/dashboard-mode-map (kbd "g"))
                    'et/dashboard-refresh)))
      (should (eq (lookup-key et/leader-map (kbd "d")) 'et/dashboard)))))

(ert-deftest et/dashboard-renders-project-and-recent-buttons ()
  (et/with-test-vault
    (let* ((project (expand-file-name "project/" directory))
           (file (expand-file-name "recent.org" directory))
           (projectile-known-projects (list project))
           (recentf-list (list file))
           (org-agenda-files nil)
           (et/org-domain "personal"))
      (make-directory project t)
      (with-temp-file file (insert "Recent fixture\n"))
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (should (string-match-p (regexp-quote (abbreviate-file-name project))
                                (buffer-string)))
        (should (string-match-p (regexp-quote (abbreviate-file-name file))
                                (buffer-string)))
        (goto-char (point-min))
        (should (next-button (point-min)))))))

(ert-deftest et/dashboard-project-entry-activates-workspace ()
  (let (seen)
    (cl-letf (((symbol-function 'projectile-switch-project-by-name)
               (lambda (project) (setq seen project))))
      (et/dashboard-open-project "/tmp/dashboard-project/")
      (should (equal seen "/tmp/dashboard-project/")))))

(ert-deftest et/dashboard-agenda-shows-today-todo ()
  (et/with-test-vault
    (let* ((file (expand-file-name "personal/tasks.org" et/notes-directory))
           (org-agenda-files (list file))
           (et/org-domain "personal"))
      (make-directory (file-name-directory file) t)
      (with-temp-file file (insert "* TODO Today task\n"))
      (should (seq-some (lambda (item)
                          (string-match-p "Today task" (nth 0 item)))
                        (et/dashboard-agenda-items))))))

(ert-deftest et/dashboard-agenda-groups-limit-and-sort ()
  (et/with-test-vault
    (let* ((file (expand-file-name "roam/personal/daily/2026-10-23.org"
                                   et/notes-directory))
           (org-agenda-files (list file))
           (today (format-time-string "<%Y-%m-%d %a>"))
           (tomorrow (format-time-string "<%Y-%m-%d %a>"
                                         (time-add (current-time) 86400))))
      (make-directory (file-name-directory file) t)
      (with-temp-file file
        (insert "* TODO Later\nDEADLINE: " tomorrow "\n")
        (insert "* NEXT Undated\n")
        (insert "* TODO Today\nDEADLINE: " today "\n")
        (insert "* WAIT Waiting\n")
        (insert "* TODO Plain one\n")
        (insert "* TODO Plain two\n")
        (insert "* TODO Plain three\n"))
      (let* ((group (assoc "personal" (et/dashboard-agenda-groups)))
             (visible (nth 1 group)))
        (should (= 5 (length visible)))
        (should (= 7 (nth 2 group)))
        (should (equal '("Undated" "Today" "Later"
                         "Plain one" "Plain three")
                       (mapcar (lambda (task) (plist-get task :heading))
                               visible)))))))

(ert-deftest et/dashboard-includes-new-todo-states ()
  (et/with-test-vault
    (let* ((file (expand-file-name "personal/tasks.org" et/notes-directory))
           (org-agenda-files (list file)))
      (make-directory (file-name-directory file) t)
      (with-temp-file file
        (insert "* SHOWSTOPPER Critical\n")
        (insert "* BLOCKED Waiting on vendor\n")
        (insert "* IN-PROGRESS Working\n")
        (insert "* VALIDATION Reviewing\n")
        (insert "* HOLD Paused\n")
        (insert "* IDEA Maybe later\n"))
      (let* ((group (assoc "personal" (et/dashboard-agenda-groups)))
             (headings (mapcar (lambda (task) (plist-get task :heading))
                               (nth 1 group))))
        (should (member "Critical" headings))
        (should (member "Waiting on vendor" headings))
        (should (member "Working" headings))
        (should (member "Reviewing" headings))
        (should (= 5 (length headings)))))))

(ert-deftest et/dashboard-uses-per-state-todo-faces ()
  (et/with-test-vault
    (let* ((file (expand-file-name "personal/tasks.org" et/notes-directory))
           (org-agenda-files (list file))
           (projectile-known-projects nil)
           (recentf-list nil)
           (elfeed-db t)
           (elfeed-db-entries (make-hash-table :test #'equal))
           (et/org-domain "personal"))
      (make-directory (file-name-directory file) t)
      (with-temp-file file
        (insert "* SHOWSTOPPER Critical\n")
        (insert "* IN-PROGRESS Working\n")
        (insert "* NEXT Next task\n"))
      (et/dashboard)
      (with-current-buffer et/dashboard-buffer-name
        (goto-char (point-min))
        (search-forward "SHOWSTOPPER")
        (should (eq (get-text-property (match-beginning 0) 'face)
                    'et/org-todo-showstopper))
        (goto-char (point-min))
        (search-forward "IN-PROGRESS")
        (should (eq (get-text-property (match-beginning 0) 'face)
                    'et/org-todo-green))
        (goto-char (point-min))
        (search-forward "NEXT")
        (should (eq (get-text-property (match-beginning 0) 'face)
                    'et/org-todo-yellow))))))

